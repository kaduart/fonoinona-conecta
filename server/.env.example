# Copie para .env e preencha. O .env nunca vai para o Git.
PORT=3333
# String do Atlas (cluster conecta-prod, usuário conecta_api, banco conecta)
MONGODB_URI=mongodb+srv://conecta_api:<senha>@conecta-prod.xxxxx.mongodb.net/conecta?retryWrites=true&w=majority
# Chave para a equipe consultar leads (gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
ADMIN_API_KEY=
# Origens liberadas no CORS (só a versão web precisa), separadas por vírgula
CORS_ORIGENS=http://localhost:8081
